# Cross-repository CI access (secret)
# GitHub fine-grained PAT or GitHub App token with read access to private stack repos.
AGENT_STACK_GITHUB_TOKEN=

# Optional Hugging Face credential for gated/private model checkpoints.
# transformers/huggingface_hub consume this standard name directly.
HF_TOKEN=

# Local runtime configuration (non-secret defaults)
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-runs
DECISION_GATEWAY_URL=http://127.0.0.1:8080
PROMETHEUS_URL=http://127.0.0.1:19090
KUBERNETES_API=http://127.0.0.1:18001
AGENT_RELEASE_NAME=checkout-remediator-v2

# Local demo Temporal PostgreSQL credentials.
# Replace these in any shared/non-ephemeral environment.
AGENT_STACK_TEMPORAL_DB_USER=temporal
AGENT_STACK_TEMPORAL_DB_PASSWORD=

# Derived at deployment admission time; do not hand-maintain.
# AGENT_AUTHORITY_DIGEST=sha256:...
